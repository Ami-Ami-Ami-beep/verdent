# --- Discord-Anwendung (https://discord.com/developers/applications) ---
# Diese App wird NUR für den Login auf Website/App benutzt (OAuth2).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Muss exakt so im Developer-Portal unter OAuth2 → Redirects eingetragen sein
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/callback

# --- Server ---
# Öffentliche Adresse der Website (wohin nach dem Login weitergeleitet wird)
PUBLIC_URL=http://localhost:5173
API_PORT=3000
# Zufälliger langer Wert, z. B.: openssl rand -hex 32
SESSION_SECRET=
# 32 Byte als Hex (64 Zeichen) zum Verschlüsseln der Bot-Tokens: openssl rand -hex 32
# ACHTUNG: Geht dieser Schlüssel verloren, sind alle gespeicherten Tokens unbrauchbar.
TOKEN_ENCRYPTION_KEY=

# --- Datenbank / Redis ---
POSTGRES_PASSWORD=botpanel
DATABASE_URL=postgresql://botpanel:botpanel@localhost:5432/botpanel
REDIS_URL=redis://localhost:6379
