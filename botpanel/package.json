{
  "name": "botpanel",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @botpanel/api dev",
    "dev:web": "pnpm --filter @botpanel/web dev",
    "dev:bot": "pnpm --filter @botpanel/bot-runner dev",
    "dev:desktop": "pnpm --filter @botpanel/desktop dev",
    "db:migrate": "pnpm --filter @botpanel/db migrate:dev",
    "db:deploy": "pnpm --filter @botpanel/db migrate:deploy"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.0"
  }
}
