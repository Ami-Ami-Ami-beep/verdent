# ─── Discord Bot ─────────────────────────────────────────────
# Bot-Token aus dem Discord Developer Portal
# (https://discord.com/developers/applications)
DISCORD_TOKEN=dein-bot-token-hier

# Application (Client) ID deines Bots
CLIENT_ID=deine-application-id-hier

# Optional: Test-Server-ID, damit Slash-Commands sofort statt global erscheinen
GUILD_ID=

# Slash-Commands beim Start automatisch registrieren (1 = an, 0 = aus)
AUTO_DEPLOY=1

# ─── Konfigurations-Website (Dashboard) ──────────────────────
# Port fuer das Web-Dashboard
WEB_PORT=3000

# Passwort fuer den Login ins Dashboard (BITTE AENDERN!)
DASHBOARD_PASSWORD=admin

# Zufaelliger geheimer String fuer die Login-Sessions (BITTE AENDERN!)
SESSION_SECRET=bitte-einen-langen-zufaelligen-string-einsetzen
